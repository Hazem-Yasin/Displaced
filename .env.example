# Optional. Everything works without keys; keys raise limits / improve quality.

# Free key (higher daily limit + longer history): https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# https://newsapi.org (free plan is for development only). If empty, Google News RSS is used.
NEWS_API_KEY=

# Production only: comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=

# Frontend (Vite) -> where the API lives. Leave empty in dev (Vite proxies /api).
VITE_API_BASE=
